<?xml version="1.0"?>
<!-- The Holybro X500 v2 of ctu-mrs/mrs_uav_gazebo_simulator (commit e6b3488),
     models/mrs_robots_description/sdf/x500.sdf.jinja rendered without sensors: every
     visual as a mesh on the UAV's fcu frame (the SDF base_link). See README.md.
     mrs_simulator fills in the UAV name and this directory before it publishes. -->
<robot name="x500">
  <link name="{uav}/fcu">
    <visual><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 1.570796"/><geometry><mesh filename="file://{dir}/meshes/top_board_mesh_file.stl" scale="1 1 1"/></geometry><material name="carbon"><color rgba="0.12 0.12 0.13 1"/></material></visual>
    <visual><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 1.570796"/><geometry><mesh filename="file://{dir}/meshes/bottom_board_mesh_file.stl" scale="1 1 1"/></geometry><material name="carbon"><color rgba="0.12 0.12 0.13 1"/></material></visual>

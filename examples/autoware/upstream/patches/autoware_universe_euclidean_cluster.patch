# autoware_universe_euclidean_cluster: the edits of the hypha port, applied to a copy of
# upstream/autoware_universe/perception/autoware_euclidean_cluster by the build (patch -p1). Every edit is also
# marked '// hypha port:' with its reason.
--- a/test/test_voxel_grid_based_euclidean_cluster.cpp
+++ b/test/test_voxel_grid_based_euclidean_cluster.cpp
@@ -15,7 +15,18 @@
 #include "autoware/euclidean_cluster/voxel_grid_based_euclidean_cluster.hpp"
 
 #include <autoware/point_types/types.hpp>
-#include <experimental/random>
+// hypha port: std::experimental::randint is libstdc++'s only; a seeded <random> engine
+// draws from the same closed range.
+#include <random>
+
+namespace
+{
+int randint(int low, int high)
+{
+  static std::mt19937 engine{42};
+  return std::uniform_int_distribution<int>{low, high}(engine);
+}
+}  // namespace
 
 #include <sensor_msgs/msg/point_cloud2.hpp>
 #include <sensor_msgs/point_cloud2_iterator.hpp>
@@ -53,8 +64,9 @@
   pointcloud.is_bigendian = false;
   pointcloud.is_dense = true;
   pointcloud.header.frame_id = "dummy_frame_id";
-  pointcloud.header.stamp.sec = 0;
-  pointcloud.header.stamp.nanosec = 0;
+  // hypha port: ROS 1 stamps (secs, nsecs) until ROS 2 definitions (#45); every stamp field in this file is renamed.
+  pointcloud.header.stamp.secs = 0;
+  pointcloud.header.stamp.nsecs = 0;
 }
 
 sensor_msgs::msg::PointCloud2 generateClusterWithinVoxel(const int nb_points)
@@ -66,9 +78,9 @@
   // generate one cluster with specified number of points within 1 voxel
   for (int i = 0; i < nb_points; ++i) {
     PointXYZI point;
-    point.x = std::experimental::randint(0, 30) / 100.0;  // point.x within 0.0 to 0.3
-    point.y = std::experimental::randint(0, 30) / 100.0;  // point.y within 0.0 to 0.3
-    point.z = std::experimental::randint(0, 30) / 1.0;
+    point.x = randint(0, 30) / 100.0;  // point.x within 0.0 to 0.3
+    point.y = randint(0, 30) / 100.0;  // point.y within 0.0 to 0.3
+    point.z = randint(0, 30) / 1.0;
     point.intensity = 0.0;
     memcpy(&pointcloud.data[i * pointcloud.point_step], &point, pointcloud.point_step);
   }

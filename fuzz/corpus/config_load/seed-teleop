# teleop: fly uav1 from the keyboard (examples/mrs/launch.sh up --attach).
uav_name = "${UAV_NAME}"
step_m = 0.5          # one move key press
yaw_step_deg = 15.0   # one q/e press

[node]
name = "${UAV_NAME}_teleop"

[ports.inputs.uav_state]
topic = "/${UAV_NAME}/estimation_manager/uav_state"
[ports.inputs.control_manager_diagnostics]
topic = "/${UAV_NAME}/control_manager/diagnostics"
[ports.inputs.hw_api_status]
topic = "/${UAV_NAME}/hw_api/status"

# The request topics of the services teleop calls (mrs::Request).
[ports.outputs.uav1.hw_api.arming.request]
topic = "/${UAV_NAME}/hw_api/arming/request"
[ports.outputs.uav1.hw_api.offboard.request]
topic = "/${UAV_NAME}/hw_api/offboard/request"
[ports.outputs.uav1.control_manager.toggle_output.request]
topic = "/${UAV_NAME}/control_manager/toggle_output/request"
[ports.outputs.uav1.control_manager.goto.request]
topic = "/${UAV_NAME}/control_manager/goto/request"
[ports.outputs.uav1.uav_manager.takeoff.request]
topic = "/${UAV_NAME}/uav_manager/takeoff/request"

# The status line goes to stdout; the log to stderr, which launch/mrs_teleop.toml writes to
# $MRS_LOGS/teleop.log.
[log]
level = "info"
console = true

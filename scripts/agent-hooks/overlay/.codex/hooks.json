{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/hypha_hooks.py\" --agent codex --event pre-tool",
            "timeout": 30,
            "statusMessage": "hypha agent fence"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/hypha_hooks.py\" --agent codex --event post-edit",
            "timeout": 60,
            "statusMessage": "rustfmt and hypha Rust checks"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/hypha_hooks.py\" --agent codex --event stop",
            "timeout": 900,
            "statusMessage": "cargo clippy on the changed crates"
          }
        ]
      }
    ]
  }
}
